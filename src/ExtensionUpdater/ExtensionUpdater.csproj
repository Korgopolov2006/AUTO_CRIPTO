<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExtensionUpdater</AssemblyName>
    <RootNamespace>ExtensionUpdater</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Один автономный exe: запускается на компьютере без установленного .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Version>1.1.0</Version>
    <Product>Обновление расширений SetupAssistant</Product>
  </PropertyGroup>

  <!-- Код обновления лежит в основном проекте (там он встроен в exe как режим «update-distributions»); здесь он подключён ссылкой,
       чтобы сборка единого exe могла чистить старые .crx без запуска приложения с правами администратора. -->
  <ItemGroup>
    <Compile Include="..\SetupAssistant\Helpers\Authenticode.cs" Link="Authenticode.cs" />
    <Compile Include="..\SetupAssistant\Updater\*.cs" LinkBase="Updater" />
  </ItemGroup>

</Project>
