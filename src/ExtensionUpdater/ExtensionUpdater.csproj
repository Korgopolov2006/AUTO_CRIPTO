<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ExtensionUpdater</AssemblyName>
    <RootNamespace>ExtensionUpdater</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Один автономный exe: запускается на компьютере без установленного .NET -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <Version>1.0.0</Version>
    <Product>Обновление расширений SetupAssistant</Product>
  </PropertyGroup>

</Project>
