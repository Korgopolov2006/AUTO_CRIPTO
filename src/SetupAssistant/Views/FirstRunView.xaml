<UserControl x:Class="SetupAssistant.Views.FirstRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SetupAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Добро пожаловать" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Три коротких шага, чтобы быстро понять, что есть на этом компьютере и что ему нужно для работы с электронной подписью." />

            <!-- Ход -->
            <Border Style="{StaticResource CardStyle}" Padding="20,12" Margin="0,0,0,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding StepTitle}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding StepNumberText}" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right" />
                    </Grid>
                    <ProgressBar Margin="0,10,0,0" Minimum="0" Maximum="100" Value="{Binding StepProgress, Mode=OneWay}"
                                 AutomationProperties.Name="Ход мастера первого запуска" />
                </StackPanel>
            </Border>

            <!-- Шаг 1: что установлено -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding IsFirstStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Не на каждом компьютере нужно всё сразу: «не установлено» — это просто сведения, а не ошибка." />
                    <controls:SkeletonList Rows="6" Visibility="{Binding ShowOverviewSkeleton, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Overview}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5" ToolTip="{Binding Advice}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="230" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusIconTemplate}"
                                                      VerticalAlignment="Top" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding DashboardText}" Style="{StaticResource MutedTextStyle}"
                                               FontSize="13" VerticalAlignment="Top" Margin="0,1,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Шаг 2: что нужно -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding IsSecondStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Отметьте, для чего этот компьютер. Мы подготовим список в мастере настройки — ничего не будет установлено, пока вы сами не нажмёте «Начать настройку»." />
                    <ItemsControl ItemsSource="{Binding Needs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,0,10" MinWidth="0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Шаг 3: носитель -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16"
                    Visibility="{Binding IsThirdStep, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Если электронная подпись хранится на токене (Рутокен, JaCarta), подключите его к USB-порту. Если токена нет или он нужен не сейчас, этот шаг можно пропустить." />
                    <StackPanel Orientation="Horizontal">
                        <ui:FontIcon Glyph="&#xE88E;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Top">
                            <ui:FontIcon.Style>
                                <Style TargetType="ui:FontIcon">
                                    <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTokenConnected}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:FontIcon.Style>
                        </ui:FontIcon>
                        <TextBlock Text="{Binding TokenText}" TextWrapping="Wrap" MaxWidth="620" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопки -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Content="Пропустить" Command="{Binding SkipCommand}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Назад" Margin="0,0,10,0" Command="{Binding BackCommand}"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
                    <Button Content="Далее" Style="{StaticResource AccentButtonStyle}" Padding="24,6" Command="{Binding NextCommand}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                    <Button Content="Готово" Style="{StaticResource AccentButtonStyle}" Padding="24,6" Command="{Binding FinishCommand}"
                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
