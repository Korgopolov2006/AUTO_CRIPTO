<UserControl x:Class="SetupAssistant.Views.SignatureTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SetupAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasCertificates, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Margin="36,28,36,28" MaxWidth="820" HorizontalAlignment="Left">
                <TextBlock Text="Тест подписи" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Проверка, что электронная подпись реально работает: приложение подпишет тестовые данные выбранным сертификатом и проверит подпись — тем же путём, каким подписывает браузерный плагин." />

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate}"
                                  HorizontalAlignment="Stretch" ui:ControlHelper.Header="Сертификат для проверки">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Owner}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource MutedTextStyle}">
                                            <Run Text="до " /><Run Text="{Binding ValidTo, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" /><Run Text=" · " /><Run Text="{Binding ExpiryText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Выполнить тест" Style="{StaticResource AccentButtonStyle}" Padding="20,6"
                                    Command="{Binding RunCommand}" IsEnabled="{Binding CanRun}" />
                            <ui:ProgressRing Width="20" Height="20" Margin="14,0,0,0" IsActive="{Binding IsRunning}"
                                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Итог -->
                <Border Margin="0,0,0,16" Padding="20,14" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon FontSize="26" VerticalAlignment="Top" Margin="0,0,14,0">
                            <ui:FontIcon.Style>
                                <Style TargetType="ui:FontIcon">
                                    <Setter Property="Glyph" Value="&#xEA39;" />
                                    <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ResultSuccess}" Value="True">
                                            <Setter Property="Glyph" Value="&#xE73E;" />
                                            <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:FontIcon.Style>
                        </ui:FontIcon>
                        <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepCardTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <controls:EmptyState Glyph="&#xE70F;" Title="Нет сертификатов с закрытым ключом"
                             Hint="Подключите токен с ключом электронной подписи и нажмите F5. Тест работает только с сертификатами, закрытый ключ которых доступен на этом компьютере."
                             Visibility="{Binding HasNoCertificates, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
