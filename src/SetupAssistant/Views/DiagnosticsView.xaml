<UserControl x:Class="SetupAssistant.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:SetupAssistant.Helpers"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <helpers:StatusLevelToBrushConverter x:Key="StatusToBrush" />
        <helpers:StatusLevelToTextConverter x:Key="StatusToText" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="← Назад" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoBackCommand}" Margin="0,0,12,0" />
            <TextBlock Text="Диагностика рабочего места" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Запустить диагностику" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding RunDiagnosticCommand}" />
            <Button Content="Экспорт отчёта" Style="{StaticResource SecondaryButtonStyle}" Margin="12,0,0,0"
                    Command="{Binding ExportReportCommand}" />
            <TextBlock Text="{Binding CurrentStepText}" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" Margin="0,0,0,16" Height="4"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <DataGrid DockPanel.Dock="Top" ItemsSource="{Binding Components}" MaxHeight="560">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="30">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Style="{StaticResource StatusDotStyle}"
                                     Fill="{Binding Status, Converter={StaticResource StatusToBrush}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Компонент" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Статус" Binding="{Binding Status, Converter={StaticResource StatusToText}}" Width="1.2*" />
                <DataGridTextColumn Header="Найденная версия" Binding="{Binding InstalledVersion}" Width="1.3*" />
                <DataGridTextColumn Header="Рекомендуемая версия" Binding="{Binding RecommendedVersion}" Width="1.3*" />
                <DataGridTextColumn Header="Описание / ошибка" Binding="{Binding ErrorMessage}" Width="2.5*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
