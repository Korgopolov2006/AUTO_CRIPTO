<UserControl x:Class="SetupAssistant.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SetupAssistant.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,28,36,28" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="{Binding AppName}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding AppVersion, StringFormat='Версия приложения: {0}'}"
                       Style="{StaticResource PageSubtitleStyle}" />

            <!-- Готовность рабочего места -->
            <Border Margin="0,0,0,20" Padding="24,20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ReadinessLevel}" Value="{x:Static models:StatusLevel.Ok}">
                                <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReadinessLevel}" Value="{x:Static models:StatusLevel.Warning}">
                                <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ReadinessLevel}" Value="{x:Static models:StatusLevel.Error}">
                                <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Viewbox Width="48" Height="48" VerticalAlignment="Top" Margin="0,2,20,0">
                            <ContentPresenter Content="{Binding ReadinessLevel}" ContentTemplate="{StaticResource StatusIconTemplate}" />
                        </Viewbox>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding ReadinessTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReadinessText}" Style="{StaticResource MutedTextStyle}" FontSize="14"
                                       Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Исправить" Style="{StaticResource AccentButtonStyle}" Padding="20,6"
                                        Command="{Binding FixCommand}"
                                        Visibility="{Binding CanFix, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Показать ход настройки" Style="{StaticResource AccentButtonStyle}" Padding="20,6"
                                        Command="{Binding ShowSetupProgressCommand}"
                                        Visibility="{Binding IsSetupRunning, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Проверить снова" Margin="12,0,0,0" Padding="16,6"
                                        Command="{Binding RecheckCommand}"
                                        IsEnabled="{Binding IsChecking, Converter={StaticResource InverseBool}}" />
                                <Button Content="Подробности" Margin="12,0,0,0" Padding="16,6"
                                        Command="{Binding CheckWorkplaceCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Что именно не так -->
                    <StackPanel Margin="68,18,0,0" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,0,0,10" />
                        <ItemsControl ItemsSource="{Binding Issues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusIconTemplate}"
                                                          VerticalAlignment="Top" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding HiddenIssuesText}" Style="{StaticResource MutedTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Уведомление об обновлениях -->
            <Border Margin="0,0,0,20">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdateNotice}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:FontIcon Glyph="&#xE895;" FontSize="20" VerticalAlignment="Top" Margin="0,2,16,0"
                                 Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Обновления расширений" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UpdateNotice}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основные действия -->
            <TextBlock Text="Основные действия" Style="{StaticResource SectionTitleStyle}" />
            <Grid Margin="0,0,0,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource AccentActionTileStyle}"
                        Command="{Binding SetupWorkplaceCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE768;" FontSize="28" Margin="0,0,18,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Настроить рабочее место" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Выбрать компоненты, установить и настроить"
                                       TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85" />
                        </StackPanel>
                    </Grid>
                </Button>

                <Button Grid.Column="2" Style="{StaticResource ActionTileStyle}"
                        Command="{Binding CheckWorkplaceCommand}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:FontIcon Glyph="&#xE9D9;" FontSize="28" Margin="0,0,18,0" VerticalAlignment="Center"
                                     Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Диагностика" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Полная проверка компонентов, отчёт"
                                       Style="{StaticResource MutedTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <!-- Сведения о системе -->
            <TextBlock Text="Сведения о рабочей станции" Style="{StaticResource SectionTitleStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                        <RowDefinition Height="Auto" MinHeight="32" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Имя компьютера" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SystemInfo.ComputerName}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="1" Text="Пользователь" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SystemInfo.UserName}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="2" Text="Версия Windows" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SystemInfo.WindowsVersion}" TextWrapping="Wrap" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="3" Text="Архитектура" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SystemInfo.Architecture}" VerticalAlignment="Center" />

                    <TextBlock Grid.Row="4" Text="Дата запуска" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SystemInfo.StartedAt, StringFormat='dd.MM.yyyy HH:mm:ss'}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Button Content="Выход" Command="{Binding ExitCommand}" HorizontalAlignment="Left" Margin="0,24,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
