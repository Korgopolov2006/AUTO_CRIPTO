<UserControl x:Class="SetupAssistant.Views.CertificatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SetupAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <DockPanel Margin="36,28,36,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Сертификаты электронной подписи" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Сертификаты, найденные на подключённых носителях и в хранилище" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <!-- Носитель -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Padding="16,10" Margin="0,0,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <ui:FontIcon Glyph="&#xE88E;" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ui:FontIcon.Style>
                        <Style TargetType="ui:FontIcon">
                            <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTokenConnected}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:FontIcon.Style>
                </ui:FontIcon>
                <TextBlock Text="{Binding TokenStatusText}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Поиск и действия -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ui:ControlHelper.PlaceholderText="Поиск по владельцу, организации, номеру, отпечатку" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Обновить" Margin="0,0,12,0" Command="{Binding LoadCertificatesCommand}" />
                <Button Content="Установить выбранный" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding InstallSelectedCommand}" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <DataGrid ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate}" SelectionMode="Single"
                          Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Срок" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <ContentPresenter Content="{Binding ExpiryLevel}" ContentTemplate="{StaticResource StatusIconTemplate}" />
                                        <TextBlock Text="{Binding ExpiryText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Владелец" Binding="{Binding Owner}" Width="1.5*" MinWidth="140" />
                        <DataGridTextColumn Header="Организация" Binding="{Binding Organization}" Width="1.5*" MinWidth="120" />
                        <DataGridTextColumn Header="Действителен до" Binding="{Binding ValidTo, StringFormat='dd.MM.yyyy'}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <controls:EmptyState Glyph="&#xEB95;" Title="Сертификатов нет" Hint="{Binding EmptyText}"
                                     Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </Grid>

            <!-- Подробности выбранного сертификата -->
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Width="300" Margin="16,0,0,0"
                    Visibility="{Binding SelectedCertificate, Converter={StaticResource NullToCollapsed}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Подробности" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Text="Владелец" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.Owner}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Организация" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.Organization}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Контейнер" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.Container}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Срок действия" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
                            <Run Text="{Binding SelectedCertificate.ValidFrom, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" />
                            <Run Text="—" />
                            <Run Text="{Binding SelectedCertificate.ValidTo, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" />
                            <Run Text="{Binding SelectedCertificate.ExpiryText, Mode=OneWay, StringFormat=' ({0})'}" />
                        </TextBlock>

                        <TextBlock Text="Серийный номер" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.SerialNumber}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,10" />

                        <TextBlock Text="Отпечаток" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.Thumbprint}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,10" />

                        <TextBlock Text="Назначение (EKU)" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.ExtendedKeyUsage}" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <TextBlock Text="Политики (OID)" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.PolicyOids}" TextWrapping="Wrap" FontFamily="Consolas" Margin="0,0,0,10" />

                        <TextBlock Text="Проверка" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding SelectedCertificate.ValidationSummary}" TextWrapping="Wrap" Margin="0,0,0,14" />

                        <WrapPanel>
                            <Button Content="Копировать отпечаток" Margin="0,0,8,8" Command="{Binding CopyCommand}" CommandParameter="thumbprint" />
                            <Button Content="Копировать номер" Margin="0,0,0,8" Command="{Binding CopyCommand}" CommandParameter="serial" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
