<UserControl x:Class="SetupAssistant.Views.LogViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SetupAssistant.Controls"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <DockPanel Margin="36,28,36,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Журнал действий" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding LogFilePath}" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource MutedTextStyle}"
                       VerticalAlignment="Center" Margin="16,0,0,0" />
            <WrapPanel>
                <ComboBox AutomationProperties.Name="Уровень записей" ItemsSource="{Binding LevelOptions}" SelectedValuePath="Value" DisplayMemberPath="Title"
                          SelectedValue="{Binding LevelFilter}" Width="170" Margin="0,0,12,8" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="260" AutomationProperties.Name="Поиск по журналу" Margin="0,0,12,8"
                         ui:ControlHelper.PlaceholderText="Поиск по тексту записи" />
                <CheckBox Content="Следить за новыми" IsChecked="{Binding FollowNewEntries}" Margin="0,0,16,8" />
                <Button Content="Копировать" Margin="0,0,8,8"
                        Command="{Binding CopyCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=EntriesGrid}" />
                <Button Content="Открыть папку" Margin="0,0,8,8" Command="{Binding OpenLogFolderCommand}" />
                <Button Content="Пакет для поддержки" Margin="0,0,0,8" Command="{Binding CreateSupportBundleCommand}"
                        ToolTip="Журналы, диагностика и сведения о системе в одном zip. PIN-коды и ключи не включаются" />
            </WrapPanel>
        </DockPanel>

        <Grid>
            <DataGrid x:Name="EntriesGrid" ItemsSource="{Binding Entries}" SelectionMode="Extended" AutomationProperties.Name="Журнал действий"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource DataGridMutedTextStyle}" Header="Когда" Binding="{Binding Timestamp, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="Auto" />
                    <DataGridTemplateColumn Header="Уровень" Width="Auto" MinWidth="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="Pill" Style="{StaticResource PillStyle}">
                                    <TextBlock x:Name="Label" Text="{Binding Level, Converter={StaticResource LogLevelToText}}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource StatusWarningTintBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource StatusErrorTintBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="Critical">
                                        <Setter TargetName="Pill" Property="Background" Value="{StaticResource StatusErrorTintBrush}" />
                                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn ElementStyle="{StaticResource DataGridStrongTextStyle}" Header="Действие" Binding="{Binding Action}" Width="1.8*" MinWidth="140" />
                    <DataGridTextColumn ElementStyle="{StaticResource DataGridWrapTextStyle}" Header="Результат" Binding="{Binding Result}" Width="1.8*" MinWidth="160" />
                    <DataGridTextColumn ElementStyle="{StaticResource DataGridWrapTextStyle}" Header="Ошибка" Binding="{Binding ErrorText}" Width="2*" MinWidth="160" />
                </DataGrid.Columns>
            </DataGrid>

            <controls:EmptyState Glyph="&#xE8A5;" Title="Записей нет"
                                 Hint="Ничего не подходит под выбранный уровень или текст поиска."
                                 Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
