<UserControl x:Class="SetupAssistant.Views.UninstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <DockPanel Margin="36,28,36,28">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Удаление компонентов" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Откат установки, выполненной мастером" Style="{StaticResource PageSubtitleStyle}" />
        </StackPanel>

        <Border DockPanel.Dock="Top" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock TextWrapping="Wrap"
                           Text="Удаляются установленные мастером программы (в обратном порядке), политика установки расширений, остаточные файлы и кэш приложения. Ключи, ключевые контейнеры и содержимое токена не удаляются." />
                <CheckBox Margin="0,12,0,0" IsChecked="{Binding RemovePersonalCertificates}">
                    <TextBlock TextWrapping="Wrap"
                               Text="Также удалить из хранилища «Личное» сертификаты, привязанные к ключам КриптоПро (вернуть их можно повторной настройкой с токена)" />
                </CheckBox>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Удалить" Style="{StaticResource AccentButtonStyle}" Command="{Binding StartUninstallCommand}" />
            <Button Content="Обновить список" Margin="12,0,0,0" Command="{Binding RescanCommand}" />
            <Button Content="Отмена" Margin="12,0,0,0" Command="{Binding CancelUninstallCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ContentPresenter DockPanel.Dock="Top" Margin="0,0,0,16" Content="{Binding}"
                          ContentTemplate="{StaticResource StepsProgressTemplate}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource StepCardTemplate}" Margin="0,0,12,0" />
        </ScrollViewer>
    </DockPanel>
</UserControl>
