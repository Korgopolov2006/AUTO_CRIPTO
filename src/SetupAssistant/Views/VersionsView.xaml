<UserControl x:Class="SetupAssistant.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SetupAssistant.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <UserControl.Resources>
        <!-- Одна строка: компонент, вывод и четыре числа в ряд -->
        <DataTemplate x:Key="VersionRowTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="18,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding Level}" ContentTemplate="{StaticResource StatusIconTemplate}"
                                          VerticalAlignment="Top" Margin="0,2,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="4" Margin="30,10,0,0">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Установлено" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding Installed}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Допустимо от" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding Minimum}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Рекомендуется" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding Recommended}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Актуальная на сервере" Style="{StaticResource MutedTextStyle}" FontSize="12" />
                            <TextBlock Text="{Binding Latest}" TextWrapping="Wrap" />
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap" Margin="30,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="36,28,36,0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Версии" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Margin="0,0,0,12"
                       Text="Что установлено на компьютере, какие версии допустимы по конфигурации и что сейчас выложено у производителей." />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,28" MaxWidth="980" HorizontalAlignment="Left">

                <!-- Итог -->
                <Border Margin="0,0,0,20" Padding="24,18">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static models:StatusLevel.Ok}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static models:StatusLevel.Warning}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static models:StatusLevel.Error}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="40" Height="40" VerticalAlignment="Top" Margin="0,2,18,0">
                            <ContentPresenter Content="{Binding SummaryLevel}" ContentTemplate="{StaticResource StatusIconTemplate}" />
                        </Viewbox>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SummaryTitle}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedTextStyle}" FontSize="14" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CheckedAtText}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="0,4,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Проверить актуальные версии" Style="{StaticResource AccentButtonStyle}" Padding="18,6"
                                        Command="{Binding CheckCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
                                <Button Content="Перейти к обновлению" Margin="12,0,0,0" Padding="16,6"
                                        Command="{Binding OpenSetupCommand}"
                                        Visibility="{Binding CanOpenSetup, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="Откроет «Настройку» с отмеченными компонентами. Ничего не запустится, пока вы сами не нажмёте «Начать настройку»" />
                                <Button Content="Изменить допустимые версии" Margin="12,0,0,0" Padding="16,6"
                                        Command="{Binding OpenConfigEditorCommand}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                <ui:ProgressRing Width="18" Height="18" IsActive="{Binding IsBusy}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding BusyMessage}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="Программы и драйверы" Style="{StaticResource SectionTitleStyle}" />
                <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource VersionRowTemplate}" Margin="0,0,0,20" />

                <TextBlock Text="Расширения браузера" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Text="Для расширений «Установлено» — версия файла .crx в вашем репозитории (из конфигурации), «Актуальная» — версия в Chrome Web Store." />
                <ItemsControl ItemsSource="{Binding Extensions}" ItemTemplate="{StaticResource VersionRowTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
