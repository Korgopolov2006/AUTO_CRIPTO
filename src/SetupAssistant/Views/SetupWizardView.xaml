<UserControl x:Class="SetupAssistant.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:SetupAssistant.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700">

    <DockPanel Margin="36,28,36,0">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Настройка рабочего места" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Отметьте компоненты для установки. Уже установленные будут пропущены." Style="{StaticResource PageSubtitleStyle}"
                       Margin="0,0,0,12" />
        </StackPanel>

        <!-- Действия -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Начать настройку" Style="{StaticResource AccentButtonStyle}" Margin="0,0,12,6" Padding="18,6"
                    Command="{Binding StartSetupCommand}" />
            <Button Content="КриптоПро" Style="{StaticResource AccentButtonStyle}" Margin="0,0,8,6" Padding="18,6"
                    Command="{Binding SetupCryptoProCommand}" IsEnabled="{Binding CanEditSelection}"
                    ToolTip="Настройка КриптоПро и остальных компонентов, без Континент-АП" />
            <Button Content="КриптоПро с Континентом" Style="{StaticResource AccentButtonStyle}" Margin="0,0,12,6" Padding="18,6"
                    Command="{Binding SetupCryptoProWithKontinentCommand}" IsEnabled="{Binding CanEditSelection}"
                    ToolTip="Настройка КриптоПро, остальных компонентов и Континент-АП (если в конфигурации задан его дистрибутив)" />
            <Button Content="Отмена" Margin="0,0,12,6" Padding="18,6" Command="{Binding CancelSetupCommand}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="Выбрать всё" Margin="0,0,8,6" Command="{Binding SelectAllCommand}"
                    IsEnabled="{Binding CanEditSelection}" />
            <Button Content="Снять выбор" Margin="0,0,8,6" Command="{Binding SelectNoneCommand}"
                    IsEnabled="{Binding CanEditSelection}" />
            <Button Content="Только недостающие" Margin="0,0,14,6" Command="{Binding SelectProblemsCommand}"
                    IsEnabled="{Binding CanEditSelection}" />
            <CheckBox Content="Переустановить установленные" MinWidth="0" Margin="0,0,14,6" IsChecked="{Binding ForceReinstall}"
                      IsEnabled="{Binding CanEditSelection}" />
            <CheckBox Content="Скрыть выполненные" MinWidth="0" Margin="0,0,0,6" IsChecked="{Binding HideCompleted}" />
        </WrapPanel>

        <!-- Индикатор выполнения закреплён вверху -->
        <ContentPresenter DockPanel.Dock="Top" Margin="0,0,0,12" Content="{Binding}"
                          ContentTemplate="{StaticResource StepsProgressTemplate}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,12,28">

                <!-- Итоги -->
                <Border Margin="0,0,0,12" Padding="20,16"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static models:StatusLevel.Ok}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusOkBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static models:StatusLevel.Warning}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SummaryLevel}" Value="{x:Static models:StatusLevel.Error}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="36" Height="36" VerticalAlignment="Top" Margin="0,0,16,0">
                            <ContentPresenter Content="{Binding SummaryLevel}" ContentTemplate="{StaticResource StatusIconTemplate}" />
                        </Viewbox>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding SummaryTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding SummaryText}" Style="{StaticResource MutedTextStyle}" FontSize="13" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Перезагрузить и продолжить" Style="{StaticResource AccentButtonStyle}" Margin="0,0,10,6"
                                        Command="{Binding RestartAndResumeCommand}"
                                        Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Повторить неудачные" Margin="0,0,10,6" Command="{Binding RetryFailedCommand}"
                                        Visibility="{Binding HasFailedSteps, Converter={StaticResource BoolToVisibility}}" />
                                <Button Content="Экспорт отчёта" Margin="0,0,10,6" Command="{Binding ExportReportCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Предварительная проверка -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="20,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="Предварительная проверка" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:ProgressRing Width="18" Height="18" IsActive="{Binding IsPreflightRunning}"
                                                 Visibility="{Binding IsPreflightRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,0" />
                                <Button Content="Проверить снова" Padding="12,3" Command="{Binding RunPreflightCommand}"
                                        IsEnabled="{Binding IsPreflightRunning, Converter={StaticResource InverseBool}}" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PreflightChecks}" ItemTemplate="{StaticResource PreflightItemTemplate}" />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Steps}" ItemTemplate="{StaticResource SetupStepCardTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
