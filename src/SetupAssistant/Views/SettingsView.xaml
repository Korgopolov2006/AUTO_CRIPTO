<UserControl x:Class="SetupAssistant.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             Background="{DynamicResource BackgroundBrush}">
    <DockPanel Margin="32">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="← Назад" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding GoBackCommand}" Margin="0,0,12,0" />
            <TextBlock Text="Настройки" Style="{StaticResource PageTitleStyle}" Margin="0" VerticalAlignment="Center" />
        </StackPanel>

        <Button DockPanel.Dock="Top" Content="Перезагрузить конфигурацию" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Left" Margin="0,0,0,16" Command="{Binding ReloadConfigCommand}" />

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Общие сведения" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Config.AppName, StringFormat='Название: {0}'}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Config.AppVersion, StringFormat='Версия: {0}'}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Минимально допустимые версии" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Config.MinVersions.CryptoProCsp, StringFormat='КриптоПро CSP: {0}'}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Config.MinVersions.CryptoProBrowserPlugin, StringFormat='КриптоПро Browser Plugin: {0}'}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Config.MinVersions.ChromiumGost, StringFormat='Chromium GOST: {0}'}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Config.MinVersions.KonturPlugin, StringFormat='Контур.Плагин: {0}'}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Расширения браузеров" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                                   Text="Локальные .crx сравниваются с последними версиями в Chrome Web Store. Для обновления замените .crx в Appendices и укажите новую версию в Config.json." />
                        <Button Content="Проверить версии расширений" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Left" Command="{Binding CheckExtensionUpdatesCommand}" />
                        <ItemsControl ItemsSource="{Binding ExtensionUpdates}" Margin="0,12,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Summary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Параметры проверки" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding Config.CheckSettings.TokenWaitTimeoutSeconds, StringFormat='Таймаут ожидания носителя, сек: {0}'}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Config.CheckSettings.CertificateExpiryWarningDays, StringFormat='Предупреждение об истечении сертификата, дней: {0}'}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
