{
  "AppName": "Помощник настройки рабочего места для электронной подписи",
  "LogoPath": "Resources/logo.png",

  // Дистрибутивы из папки Appendices. Kind: Exe | Msi.
  // Поля для утилиты ExtensionUpdater.exe (запускается на компьютере с интернетом):
  //   UpdateUrl / DownloadUrl — откуда брать новую версию (без обоих дистрибутив зафиксирован и не обновляется);
  //   UpdateWarmupUrl — страница, которую нужно открыть перед скачиванием (сайт выдаёт файл по сессионной куке);
  //   ExpectedSigner — подстрока имени владельца подписи: файл с другой или недействительной подписью отвергается
  //   (проверка действует и при скачивании во время установки).
  "Installers": {
    // Версия зафиксирована заказчиком: 5.0.12000, не обновляется. MSI ставится тихо через msiexec /qn.
    "CryptoProCsp": {
      "Path": "Appendices\\Крипто Про Windows\\csp-x64-rus.msi",
      "Kind": "Msi",
      "SilentArgs": ""
    },
    // КриптоПро ЭЦП Browser plug-in: хост ru.cryptopro.nmcades + COM CAdESCOM (SFX с Setup.exe).
    // Ключи установщика: -silent без окон, -norestart без перезагрузки, -noroot не ставить корневые сертификаты
    // из архива (по умолчанию -root; у заказчика УЦ ставятся политиками), -noyandex не ставить Яндекс.Браузер.
    // Для Chromium GOST расширение КриптоПро встроено в браузер.
    "CryptoProBrowserPlugin": {
      "Path": "Appendices\\КриптоПро ЭЦП Browser plug-in\\cadesplugin.exe",
      "UpdateUrl": "https://cryptopro.ru/products/cades/plugin/get_2_0",
      "UpdateWarmupUrl": "https://cryptopro.ru/products/cades/plugin",
      "ExpectedSigner": "CRYPTO-PRO",
      "Kind": "Exe",
      "SilentArgs": "-silent -noroot -noyandex -norestart"
    },
    // Chromium GOST: последняя версия берётся из GitHub API (deemru/Chromium-Gost), файл выбирается
    // по regex. Ставится для всех пользователей (--system-level). Path — запасной вариант без сети.
    "ChromiumGost": {
      "Path": "Appendices\\chromium-gost-152.0.7977.149-windows-amd64-installer.exe",
      "DownloadUrl": "https://api.github.com/repos/deemru/Chromium-Gost/releases/latest",
      "DownloadAssetRegex": "windows-amd64-installer\\.exe$",
      "ExpectedSigner": "CRYPTO-PRO",
      "Kind": "Exe",
      "SilentArgs": "--system-level --do-not-launch-chrome"
    },
    // Контур.Плагин: всегда скачивается актуальная версия. NSIS-установщик: тихий режим — /S.
    // Path — запасной вариант без сети.
    "KonturPlugin": {
      "Path": "Appendices\\DiagPlugin_user.003074.exe",
      "DownloadUrl": "https://help.kontur.ru/DiagPlugin.exe",
      "ExpectedSigner": "Kontur",
      "Kind": "Exe",
      "SilentArgs": "/S"
    },
    // Плагин пользователя систем электронного правительства (native-хост ru.rtlabs.ifcplugin,
    // нужен расширению «Госуслуги»). Подписан Ростелекомом, MSI ставится тихо: msiexec /qn.
    "GosuslugiPlugin": {
      "Path": "Appendices\\Плагин Госуслуг\\IFCPlugin-x64.msi",
      "UpdateUrl": "https://ds-plugin.gosuslugi.ru/plugin/upload/assets/distrib/IFCPlugin-x64.msi",
      "ExpectedSigner": "Rostelecom",
      "Kind": "Msi",
      "SilentArgs": ""
    },
    // Драйверы Рутокен 5.3.00.0000 (MSI x64, подпись АО «Актив-софт»), источник:
    // https://www.rutoken.ru/support/download/windows/ (лицензионное соглашение принято заказчиком).
    "RutokenDriver": {
      "Path": "Appendices\\Рутокен\\rtDrivers.x64.msi",
      "UpdateUrl": "https://download.rutoken.ru/Rutoken/Drivers/Current/rtDrivers.x64.msi",
      "ExpectedSigner": "Aktiv",
      "Kind": "Msi",
      "SilentArgs": ""
    },
    "JaCartaDriver": {
      "Path": "",
      "Kind": "Msi",
      "SilentArgs": ""
    },
    // Континент-АП («Код Безопасности»): дистрибутив кладёт заказчик в Appendices\Континент-АП. Пока Path пуст, шаги установки,
    // проверки и импорта конфигурации в мастер не попадают. Kind (Msi/Exe) и SilentArgs задайте по документации установщика
    // вашей версии (тихая установка без окон и без перезагрузки). Пример: "Path": "Appendices\\Континент-АП\\ContinentAP.msi",
    // "Kind": "Msi", "SilentArgs": "". Автоматически не обновляется (UpdateUrl не задан).
    "KontinentAp": {
      "Path": "Appendices\\Континент-АП\\Континент-АП.exe",
      "Kind": "Exe",
      "SilentArgs": "/quiet /norestart"
    }
  },

  // Настройка Континент-АП: профиль подключения и сертификаты добавляются командами консольной программы клиента.
  // Mode: Auto — через КриптоПро, если он установлен (сертификат из его контейнеров), иначе через Континент-АП; CryptoPro / Continent — принудительно.
  // ProfilePath — JSON-профиль (--addProfile), ProfileScope: User — для пользователя, Global — общий (-g).
  // ServerCertificatePath / RootCertificatePath — файлы сертификатов (--importServerCertificate / --importRootCertificate), только в режиме Continent.
  // Пустые пути — шаг не добавляется. ConsolePath — VpnClientConsole.exe по умолчанию.
  "Kontinent": {
    "Mode": "Auto",
    "ConsolePath": "%ProgramFiles%\\Security Code\\Continent VPN Client\\VpnClientConsole.exe",
    "ProfilePath": "",
    "ProfileScope": "User",
    "ServerCertificatePath": "",
    "RootCertificatePath": "",
    "CommandTimeoutSeconds": 120,
    "RegistrationProgramPath": "%ProgramFiles%\\Security Code\\Continent VPN Client\\Registration.exe",
    "RegistrationFields": [
      { "Field": "ФИО", "Format": "Фамилия Имя Отчество полностью, с заглавной буквы", "Example": "Фамилия Имя Отчество" },
      { "Field": "Логин", "Format": "Латиница или как в учётной записи, без пробелов", "Example": "login" },
      { "Field": "Почта", "Format": "Адрес с символом @ и доменом", "Example": "name@example.ru" }
    ]
  },

  "MinVersions": {
    "CryptoProCsp": "5.0.0",
    "CryptoProBrowserPlugin": "2.0.0",
    "ChromiumGost": "100.0.0",
    "KonturPlugin": "1.0.0"
  },

  // Для ChromiumGost и KonturPlugin рекомендуемая версия пуста: ставится свежая с сайта,
  // сравнивать с зашитым номером не с чем. CryptoProCsp — фиксированная версия.
  "RecommendedVersions": {
    "CryptoProCsp": "5.0.12000",
    "CryptoProBrowserPlugin": "2.0.15820",
    "ChromiumGost": "",
    "KonturPlugin": ""
  },

  "RequiredComponents": {
    "CryptoProCsp": true,
    "CryptoProBrowserPlugin": true,
    "ChromiumGost": true,
    "KonturPlugin": true,
    "GosuslugiPlugin": true,
    "RutokenDriver": true,
    "JaCartaDriver": false
  },

  // Native messaging-хосты, через которые расширения браузера общаются с плагинами (имена взяты из
  // кода расширений). Хост считается найденным, если он зарегистрирован в HKLM или HKCU в одной из
  // веток RegistryRoots и файл манифеста существует.
  "NativeMessaging": {
    "RegistryRoots": [
      "SOFTWARE\\Google\\Chrome\\NativeMessagingHosts",
      "SOFTWARE\\Chromium\\NativeMessagingHosts",
      "SOFTWARE\\Microsoft\\Edge\\NativeMessagingHosts"
    ],
    "Hosts": [
      { "Name": "ru.cryptopro.nmcades", "Description": "КриптоПро ЭЦП Browser plug-in" },
      { "Name": "kd.nc", "Description": "Контур.Плагин (Диаг.Плагин)" },
      { "Name": "ru.rtlabs.ifcplugin", "Description": "Плагин Госуслуг" }
    ]
  },

  // Откат настройки (экран «Удалить компоненты»). Порядок обратный установке: браузер и плагины, затем драйвер, последним — КриптоПро CSP.
  // Находятся по названию в «Программах и компонентах» (HKLM и HKCU). MSI удаляется через msiexec /x по коду продукта
  // (у КриптоПро в реестре стоит /I — «изменить», его не используем); EXE — командой из реестра плюс Args.
  // ProcessPathContains — процессы, которые нужно закрыть перед удалением.
  // Ключи, ключевые контейнеры и содержимое токена не удаляются; ветки HKCU\SOFTWARE\Crypto Pro (контейнеры) в очистку не входят.
  "Uninstall": {
    "Products": [
      // Континент-АП удаляется первым (сетевой драйвер и служба). Kind/Args задайте по типу установщика вашей версии: у MSI код продукта
      // берётся из реестра сам, у установщика-оболочки команда берётся из UninstallString плюс Args. DataPaths — папки с настройками
      // программы, которые удаляются вместе с ней; ниже типичные расположения, уточните по установленной версии. Ключи и токен не затрагиваются.
      {
        "Name": "Континент-АП",
        "DisplayNamePatterns": [ "Континент-АП", "Континент АП", "Continent-AP", "Continent AP" ],
        "Kind": "Msi",
        "Args": "",
        "Group": "Kontinent",
        "ProcessPathContains": "\\Security Code\\",
        "DataPaths": [
          "%ProgramData%\\Security Code\\Continent-AP",
          "%ProgramData%\\Security Code\\Continent AP",
          "%APPDATA%\\Security Code\\Continent-AP",
          "%LOCALAPPDATA%\\Security Code\\Continent-AP",
          "%ProgramFiles%\\Security Code\\Continent VPN Client"
        ],
        "RegistryPaths": [
          "HKLM\\SOFTWARE\\SecurityCode",
          "HKLM\\SOFTWARE\\WOW6432Node\\SecurityCode"
        ]
      },
      { "Name": "eXtended Container (библиотека криптоконтейнеров)", "DisplayNamePatterns": [ "eXtended Container" ], "Kind": "Msi", "Group": "Kontinent", "RegistryPaths": [ "HKLM\\SOFTWARE\\Security Code\\XC" ] },
      { "Name": "Код Безопасности CSP", "DisplayNamePatterns": [ "Код Безопасности CSP" ], "Kind": "Msi", "Group": "Kontinent", "DataPaths": [ "%ProgramFiles%\\Security Code\\CSP" ] },
      { "Name": "Контур.Плагин (Диаг.Плагин)", "DisplayNamePatterns": [ "Диаг.Плагин", "Контур.Плагин" ], "Kind": "Exe", "Args": "/S", "ProcessPathContains": "\\SkbKontur\\" },
      { "Name": "Плагин Госуслуг", "DisplayNamePatterns": [ "Плагин пользователя систем электронного правительства" ], "Kind": "Msi" },
      { "Name": "КриптоПро ЭЦП Browser plug-in", "DisplayNamePatterns": [ "КриптоПро ЭЦП Browser plug-in", "CryptoPro Browser plug-in" ], "Kind": "Msi" },
      { "Name": "Драйверы Рутокен", "DisplayNamePatterns": [ "Драйверы Рутокен", "Rutoken Drivers" ], "Kind": "Msi" },
      { "Name": "КриптоПро CSP", "DisplayNamePatterns": [ "КриптоПро CSP", "CryptoPro CSP" ], "Kind": "Msi" }
    ],
    "LeftoverPaths": [
      "%ProgramData%\\Crypto Pro\\Installer Cache\\CADESCOM_*",
      "%ProgramData%\\Crypto Pro\\Installer Cache\\CryptoPro_CSP_*",
      "%LOCALAPPDATA%\\SkbKontur",
      "%APPDATA%\\Rostelecom\\IFCPlugin"
    ],
    "LeftoverRegistryKeys": [
      "HKCU\\SOFTWARE\\SKBKontur",
      "HKCU\\SOFTWARE\\Google\\Chrome\\NativeMessagingHosts\\kd.nc",
      "HKCU\\SOFTWARE\\Chromium\\NativeMessagingHosts\\kd.nc",
      "HKCU\\SOFTWARE\\Microsoft\\Edge\\NativeMessagingHosts\\kd.nc"
    ],
    // Добивка пустых остатков. Удаляется только то, в чём нет данных: папка без единого файла, ветка реестра без единого значения
    // (в ней нет ни контейнеров, ни лицензии), ProgID без рабочего CLSID. Непустое не трогается.
    "EmptyLeftoverFolders": [
      "%ProgramFiles%\\Crypto Pro",
      "%ProgramFiles(x86)%\\Crypto Pro",
      "%CommonProgramFiles%\\Crypto Pro",
      "%CommonProgramFiles(x86)%\\Crypto Pro",
      "%ProgramData%\\Crypto Pro",
      "%LOCALAPPDATA%\\Crypto Pro",
      "%APPDATA%\\Crypto Pro",
      "%ProgramFiles%\\Aktiv Co",
      "%ProgramFiles(x86)%\\Aktiv Co",
      "%ProgramFiles%\\Security Code",
      "%ProgramFiles(x86)%\\Security Code",
      "%ProgramData%\\Security Code",
      "%APPDATA%\\Security Code",
      "%LOCALAPPDATA%\\Security Code"
    ],
    "EmptyLeftoverRegistryKeys": [
      "HKLM\\SOFTWARE\\Crypto Pro",
      "HKLM\\SOFTWARE\\WOW6432Node\\Crypto Pro",
      "HKCU\\SOFTWARE\\Crypto Pro",
      "HKLM\\SOFTWARE\\SecurityCode",
      "HKLM\\SOFTWARE\\WOW6432Node\\SecurityCode"
    ],
    "OrphanProgIdPrefixes": [ "CAdESCOM." ]
  },

  // Сертификаты УЦ (корневые и промежуточные) для построения цепочки доверия. Импорт выполняется
  // только при совпадении Thumbprint (SHA-1) с файлом, действующем сроке и признаке УЦ.
  // Store: LocalMachine\Root | LocalMachine\CA | CurrentUser\Root | CurrentUser\CA.
  // Пример записи (файлы кладите в Appendices\Сертификаты УЦ\):
  //   { "Name": "Корневой сертификат УЦ", "Path": "Appendices\\Сертификаты УЦ\\root.cer",
  //     "Thumbprint": "0123456789ABCDEF0123456789ABCDEF01234567", "Store": "LocalMachine\\Root" }
  "CaCertificates": [],

  // Офлайн-установка расширений: .crx копируются в RepositoryDirectory, рядом создаётся
  // updates.xml, ID вносятся в политику ExtensionInstallForcelist перечисленных браузеров.
  // Id берётся из этого файла; Chromium определяет итоговый ID расширения по ключу в manifest.json.
  // Chromium GOST читает политики из SOFTWARE\Policies\Chromium (проверено по его chrome.dll),
  // Google Chrome — из SOFTWARE\Policies\Google\Chrome.
  "Extensions": {
    "RepositoryDirectory": "%ProgramData%\\SetupAssistant\\Extensions",
    "PolicyRegistryKeys": [
      "SOFTWARE\\Policies\\Google\\Chrome\\ExtensionInstallForcelist",
      "SOFTWARE\\Policies\\Chromium\\ExtensionInstallForcelist"
    ],
    // Проверка новых версий в Chrome Web Store при запуске. Во внутренней сети без интернета
    // тихо пропускается; новые .crx скачивает ExtensionUpdater.exe на компьютере с интернетом.
    "CheckUpdatesOnStartup": true,
    "Items": [
      {
        "Name": "Extension for CAdES Browser Plug-in",
        "Id": "pfhgbfnnjiafkhfdkmpiflachepdcjod",
        "StoreId": "pfhgbfnnjiafkhfdkmpiflachepdcjod",
        "CrxPath": "Appendices\\расширения chromium\\Extension for CAdES Browser Plug-in\\1.3.17_0.crx",
        "Version": "1.3.17",
        "Role": "CryptoPro"
      },
      {
        "Name": "CryptoPro Extension for CAdES Browser",
        "Id": "bhicbipkdjjjceomamildaakfailhbfj",
        "StoreId": "iifchhfnnmpdbibifmljnfjhpififfog",
        "CrxPath": "Appendices\\расширения chromium\\CryptoPro Extension for CAdES Browser\\1.2.13_1.crx",
        "PemPath": "Appendices\\расширения chromium\\CryptoPro Extension for CAdES Browser\\1.2.13_1.pem",
        "Version": "1.2.13",
        "Role": "Other"
      },
      {
        "Name": "Контур.Расширение",
        "Id": "momffihklfhkoakghidmkdocdkbfmoac",
        "StoreId": "momffihklfhkoakghidmkdocdkbfmoac",
        "CrxPath": "Appendices\\расширения chromium\\Контур.Расширение\\3.2.13_0.crx",
        "Version": "3.2.13",
        "Role": "Kontur"
      },
      {
        "Name": "Госплагин",
        "Id": "jabjbhgjaidecageckilhonbggakppme",
        "StoreId": "jabjbhgjaidecageckilhonbggakppme",
        "CrxPath": "Appendices\\расширения chromium\\Госплагин\\1.3.43.0_0.crx",
        "Version": "1.3.43.0",
        "Role": "Other"
      },
      {
        "Name": "Госуслуги",
        "Id": "nolhokdlfhmehdfdppgjochmgfkoihdo",
        "StoreId": "pbefkdcndngodfeigfdgiodgnmbgcfha",
        "CrxPath": "Appendices\\расширения chromium\\Госуслуги\\1.2.8_1.crx",
        "PemPath": "Appendices\\расширения chromium\\Госуслуги\\1.2.8_1.pem",
        "Version": "1.2.8",
        "Role": "Other"
      }
    ]
  },

  "Logging": {
    "LogDirectory": "Logs",
    "LogFileNamePattern": "setup-assistant-{0:yyyy-MM-dd}.log",
    "RetainDays": 30,
    "MinimumLevel": "Information"
  },

  "CheckSettings": {
    "TokenWaitTimeoutSeconds": 60,
    "TokenPollIntervalMs": 1500,
    "CertificateExpiryWarningDays": 30
  },

  "UiSettings": {
    "Theme": "Light",
    "AccentColor": "#2563EB",
    "ShowAdvancedDetails": true
  },

  "SupportedBrowsers": [
    {
      "Name": "Chromium Gost",
      "Kind": "ChromiumGost",
      "RegistryDisplayNamePattern": "Chromium-Gost",
      "ExecutableName": "chrome.exe",
      "RequiresGostSupport": true
    },
    {
      "Name": "Яндекс Браузер",
      "Kind": "Yandex",
      "RegistryDisplayNamePattern": "Yandex",
      "ExecutableName": "browser.exe",
      "RequiresGostSupport": false
    },
    {
      "Name": "Google Chrome",
      "Kind": "Chrome",
      "RegistryDisplayNamePattern": "Google Chrome",
      "ExecutableName": "chrome.exe",
      "RequiresGostSupport": false
    },
    {
      "Name": "Microsoft Edge",
      "Kind": "Edge",
      "RegistryDisplayNamePattern": "Microsoft Edge",
      "ExecutableName": "msedge.exe",
      "RequiresGostSupport": false
    }
  ]
}
