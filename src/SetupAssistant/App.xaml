<Application x:Class="SetupAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             xmlns:local="clr-namespace:SetupAssistant"
             xmlns:vm="clr-namespace:SetupAssistant.ViewModels"
             xmlns:views="clr-namespace:SetupAssistant.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemeResources AccentColor="#0F6CBD" />
                <ui:XamlControlsResources />
                <ResourceDictionary Source="Resources/Themes/AppStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
                <views:SetupWizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UninstallViewModel}">
                <views:UninstallView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:CertificatesViewModel}">
                <views:CertificatesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FirstRunViewModel}">
                <views:FirstRunView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SignatureTestViewModel}">
                <views:SignatureTestView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:TokenPinViewModel}">
                <views:TokenPinView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewerViewModel}">
                <views:LogViewerView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
                <views:VersionsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ConfigEditorViewModel}">
                <views:ConfigEditorView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
