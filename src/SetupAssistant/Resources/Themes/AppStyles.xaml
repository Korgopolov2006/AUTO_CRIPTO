<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.modernwpf.com/2019"
                    xmlns:models="clr-namespace:SetupAssistant.Models"
                    xmlns:helpers="clr-namespace:SetupAssistant.Helpers">

    <!-- Тема, акцентный цвет, шаблоны и стили элементов управления поставляет ModernWpf (App.xaml).
         Здесь — только общие стили приложения поверх них; цвета берутся из системных кистей,
         поэтому светлая/тёмная тема переключается вместе с Windows. -->

    <helpers:StatusLevelToTextConverter x:Key="StatusToText" />
    <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <helpers:StatusLevelToBrushConverter x:Key="StatusToBrush" />
    <helpers:InverseBooleanConverter x:Key="InverseBool" />
    <helpers:IsPositiveConverter x:Key="IsPositive" />
    <helpers:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <helpers:LogLevelToTextConverter x:Key="LogLevelToText" />

    <!-- Цвета состояний (одинаково читаются в светлой и тёмной теме) -->
    <SolidColorBrush x:Key="StatusOkBrush" Color="#2E9F5B" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#E5A00D" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#D13438" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#8A8A8A" />

    <!-- Заголовки и подписи -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Полоска остатка срока действия сертификата: цвет по ExpiryLevel (зелёный, жёлтый, красный) -->
    <Style x:Key="ValidityBarStyle" TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Height" Value="5" />
        <Setter Property="MinHeight" Value="5" />
        <Setter Property="Foreground" Value="{StaticResource StatusNeutralBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding ExpiryLevel}" Value="{x:Static models:StatusLevel.Ok}">
                <Setter Property="Foreground" Value="{StaticResource StatusOkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ExpiryLevel}" Value="{x:Static models:StatusLevel.Warning}">
                <Setter Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding ExpiryLevel}" Value="{x:Static models:StatusLevel.Error}">
                <Setter Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Кнопка-ссылка: текст акцентного цвета без рамки -->
    <Style x:Key="LinkButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="Presenter" TextElement.Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Presenter" Property="Opacity" Value="0.75" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Presenter" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Карточка -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20,16" />
    </Style>

    <!-- Крупная плитка-действие на главном экране -->
    <Style x:Key="ActionTileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="MinHeight" Value="92" />
    </Style>

    <Style x:Key="AccentActionTileStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="20,18" />
        <Setter Property="MinHeight" Value="92" />
    </Style>

    <!-- Текст в ячейках таблиц переносится по словам, а не уходит за границу окна; полный текст виден во всплывающей подсказке -->
    <Style x:Key="DataGridWrapTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,7" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Таблицы -->
    <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="MinRowHeight" Value="38" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>

    <!-- Значок состояния: Content = StatusLevel -->
    <DataTemplate x:Key="StatusIconTemplate" DataType="{x:Type models:StatusLevel}">
        <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
              ToolTip="{Binding Converter={StaticResource StatusToText}}"
              AutomationProperties.Name="{Binding Converter={StaticResource StatusToText}}">
            <ui:FontIcon x:Name="Icon" Glyph="&#xE91F;" FontSize="18"
                         Foreground="{StaticResource StatusNeutralBrush}" />
            <ui:ProgressRing x:Name="Ring" Width="18" Height="18" IsActive="False" Visibility="Collapsed" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:StatusLevel.Ok}">
                <Setter TargetName="Icon" Property="Glyph" Value="&#xE73E;" />
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource StatusOkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:StatusLevel.Warning}">
                <Setter TargetName="Icon" Property="Glyph" Value="&#xE7BA;" />
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:StatusLevel.Error}">
                <Setter TargetName="Icon" Property="Glyph" Value="&#xEA39;" />
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:StatusLevel.InProgress}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                <Setter TargetName="Ring" Property="IsActive" Value="True" />
            </DataTrigger>
            <DataTrigger Binding="{Binding}" Value="{x:Static models:StatusLevel.Info}">
                <Setter TargetName="Icon" Property="Glyph" Value="&#xE946;" />
                <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Цветная полоска слева на карточке: цвет по статусу (DataContext — объект со свойством Status) -->
    <Style x:Key="StatusStripStyle" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="8,0,0,8" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StatusLevel.Ok}">
                <Setter Property="Background" Value="{StaticResource StatusOkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StatusLevel.Warning}">
                <Setter Property="Background" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StatusLevel.Error}">
                <Setter Property="Background" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:StatusLevel.InProgress}">
                <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Карточка шага удаления: Title, Details, Status -->
    <DataTemplate x:Key="StepCardTemplate">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="0" helpers:AutoScroll.IsActive="{Binding IsActive}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StatusStripStyle}" />

                <Grid Grid.Column="1" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentPresenter Grid.Column="0" Content="{Binding Status}"
                                      ContentTemplate="{StaticResource StatusIconTemplate}"
                                      VerticalAlignment="Top" Margin="0,1,14,0" />

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Что делать: " FontWeight="SemiBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" /><Run Text="{Binding Advice, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Top"
                               Margin="16,2,0,0" Text="{Binding Status, Converter={StaticResource StatusToText}}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Карточка шага мастера: флажок выбора, значок, описание с разворотом, «Повторить». Команды и CanEditSelection — у ViewModel страницы -->
    <DataTemplate x:Key="SetupStepCardTemplate">
        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="0" helpers:AutoScroll.IsActive="{Binding IsActive}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource StatusStripStyle}" />

                <Grid Grid.Column="1" Margin="12,10,16,10">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" MinWidth="0" VerticalAlignment="Top" Margin="0,-1,0,0"
                              IsChecked="{Binding IsSelected}"
                              IsEnabled="{Binding DataContext.CanEditSelection, RelativeSource={RelativeSource AncestorType=UserControl}}"
                              AutomationProperties.Name="{Binding Title}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelectable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <ContentPresenter Grid.Column="1" Content="{Binding Status}"
                                      ContentTemplate="{StaticResource StatusIconTemplate}"
                                      VerticalAlignment="Top" Margin="0,1,14,0" />

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Details}" Style="{StaticResource MutedTextStyle}" Margin="0,3,0,0"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Resources>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedTextStyle}">
                                    <Setter Property="MaxHeight" Value="34" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="MaxHeight" Value="10000" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Resources>
                        </TextBlock>
                        <Button Margin="0,2,0,0" Padding="0" HorizontalAlignment="Left"
                                Command="{Binding DataContext.ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Content" Value="Показать полностью" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLongDetails}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasLongDetails}" Value="True" />
                                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Content" Value="Свернуть" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="12"
                                   Visibility="{Binding HasAdvice, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Что делать: " FontWeight="SemiBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}" /><Run Text="{Binding Advice, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="16,0,0,0" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Right"
                                   Text="{Binding Status, Converter={StaticResource StatusToText}}" />
                        <Button Content="Повторить" Margin="0,6,0,0" HorizontalAlignment="Right" Padding="12,3"
                                Command="{Binding DataContext.RetryStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding DataContext.CanEditSelection, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRetry}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Строка предварительной проверки: Status, Name, Message -->
    <DataTemplate x:Key="PreflightItemTemplate" DataType="{x:Type models:PreflightCheck}">
        <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ContentPresenter Content="{Binding Status}" ContentTemplate="{StaticResource StatusIconTemplate}"
                              VerticalAlignment="Top" Margin="0,0,12,0" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource MutedTextStyle}" />
        </Grid>
    </DataTemplate>

    <!-- Пустое состояние: значок, заголовок, пояснение (см. Controls/EmptyState) -->

    <!-- Всплывающее уведомление: ToastItem -->
    <DataTemplate x:Key="ToastTemplate" DataType="{x:Type models:ToastItem}">
        <Border x:Name="Root" Margin="0,0,0,8" Width="340" Padding="14,12" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Direction="270" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="Shift" X="0" />
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Border.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" />
                            <DoubleAnimation Storyboard.TargetName="Shift" Storyboard.TargetProperty="X" From="40" To="0" Duration="0:0:0.25">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut" />
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:FontIcon x:Name="Icon" Glyph="{Binding Glyph}" FontSize="20" VerticalAlignment="Top" Margin="0,2,12,0"
                             Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Message}" Style="{StaticResource MutedTextStyle}" Margin="0,2,0,0"
                               Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="&#xE711;" FontFamily="{DynamicResource SymbolThemeFontFamily}" FontSize="10"
                        Width="24" Height="24" Padding="0" VerticalAlignment="Top" Margin="8,-2,-6,0"
                        Style="{StaticResource LinkButtonStyle}"
                        Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" AutomationProperties.Name="Закрыть уведомление" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Success}">
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource StatusOkBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Warning}">
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource StatusWarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ToastKind.Error}">
                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource StatusErrorBrush}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Индикатор выполнения мастера/удаления: DataContext — ViewModel с CurrentStepText, ProgressPercent, CompletedStepsCount, TotalStepsCount -->
    <DataTemplate x:Key="StepsProgressTemplate">
        <Border Style="{StaticResource CardStyle}" Padding="18,10">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding CurrentStepText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
                        <TextBlock Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Run Text="Шагов:" />
                            <Run Text="{Binding CompletedStepsCount, Mode=OneWay}" />
                            <Run Text="из" />
                            <Run Text="{Binding TotalStepsCount, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource SystemControlHighlightAccentBrush}"
                                   Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                    </StackPanel>
                </Grid>
                <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressPercent}" />
            </StackPanel>
        </Border>
    </DataTemplate>

</ResourceDictionary>
